        <mxCell id="rotulo" value='&lt;span style="font-weight:600;font-size:12px;color:#2A6BC4;letter-spacing:0.14em"&gt;LO QUE SE SUBE AL AVA Y CÓMO LO USA EL DOCENTE&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="900" height="20" as="geometry"/></mxCell>
        <mxCell id="zg" value='&lt;span style="font-weight:600;font-size:12px;color:#2A6BC4;letter-spacing:0.14em"&gt;EL GRUPO SUBE&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#F1F6FD;strokeColor=#CBD9EC;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=16;spacingTop=8;container=1;pointerEvents=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="1048" height="216" as="geometry"/></mxCell>
        <mxCell id="rep" value='&lt;span style="font-weight:600;font-size:15px;color:#1A1A1A"&gt;Los repositorios&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#666666"&gt;en GitHub: se corrige main como quedó a las 23:59&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#666666"&gt;los enlaces van en el PDF&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="zg"><mxGeometry x="24" y="48" width="232" height="144" as="geometry"/></mxCell>
        <mxCell id="zip" value='&lt;span style="font-family:ui-monospace, Menlo, Consolas, monospace;font-size:13px;color:#1A1A1A;font-weight:600;"&gt;envs-grupoNN-seccion.zip&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace, Menlo, Consolas, monospace;font-size:13px;color:#666666"&gt;biblioteca-plataforma/.env&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace, Menlo, Consolas, monospace;font-size:13px;color:#666666"&gt;biblioteca-eventos/.env&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace, Menlo, Consolas, monospace;font-size:13px;color:#666666"&gt;biblioteca-bff/.env&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace, Menlo, Consolas, monospace;font-size:13px;color:#666666"&gt;…&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#666666"&gt;los .env reales, tal cual&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;strokeColor=#307FE2;strokeWidth=2;" vertex="1" parent="zg"><mxGeometry x="280" y="48" width="232" height="144" as="geometry"/></mxCell>
        <mxCell id="pdf" value='&lt;span style="font-weight:600;font-size:15px;color:#1A1A1A"&gt;El PDF&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#666666"&gt;integrantes y enlaces&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#666666"&gt;el comando que levanta todo&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#666666"&gt;docs, imágenes GHCR y bucket&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#666666"&gt;diagramas y capturas&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="zg"><mxGeometry x="792" y="48" width="232" height="144" as="geometry"/></mxCell>
        <mxCell id="zd" value='&lt;span style="font-weight:600;font-size:12px;color:#2A6BC4;letter-spacing:0.14em"&gt;EL DOCENTE&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#F1F6FD;strokeColor=#CBD9EC;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=16;spacingTop=8;container=1;pointerEvents=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="0" y="288" width="1048" height="184" as="geometry"/></mxCell>
        <mxCell id="p1" value='&lt;span style="font-weight:600;font-size:15px;color:#1A1A1A"&gt;1 · clona&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#666666"&gt;cada repositorio, todos en una misma carpeta&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="zd"><mxGeometry x="24" y="48" width="232" height="112" as="geometry"/></mxCell>
        <mxCell id="p2" value='&lt;span style="font-weight:600;font-size:15px;color:#1A1A1A"&gt;2 · descomprime&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#666666"&gt;el zip en esa carpeta: cada .env cae en su repositorio&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="zd"><mxGeometry x="280" y="48" width="232" height="112" as="geometry"/></mxCell>
        <mxCell id="p3" value='&lt;span style="font-weight:600;font-size:15px;color:#1A1A1A"&gt;3 · levanta&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace, Menlo, Consolas, monospace;font-size:13px;color:#1A1A1A;"&gt;bash levantar.sh&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#666666"&gt;desde biblioteca-plataforma&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;strokeColor=#307FE2;strokeWidth=2;" vertex="1" parent="zd"><mxGeometry x="536" y="48" width="232" height="112" as="geometry"/></mxCell>
