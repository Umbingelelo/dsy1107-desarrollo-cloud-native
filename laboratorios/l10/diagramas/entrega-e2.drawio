        <mxCell id="ley0t" value='&lt;span style="font-size:13px;color:#666666"&gt;el zip deja el sistema listo para levantar con un comando&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="496" width="472" height="20" as="geometry"/></mxCell>
        <mxCell id="pie" value='&lt;span style="font-size:14px;color:#666666"&gt;Los .env no se versionan: sin el zip, el docente no puede levantar nada. Por eso cada .env va en la misma carpeta que tiene en el equipo del grupo.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="532" width="960" height="40" as="geometry"/></mxCell>
