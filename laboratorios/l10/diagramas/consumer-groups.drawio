        <mxCell id="ley0t" value='&lt;span style="font-size:13px;color:#666666"&gt;dos consumer groups sobre el mismo topic, cada uno con su offset&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="528" height="20" as="geometry"/></mxCell>
        <mxCell id="pie" value='&lt;span style="font-size:14px;color:#666666"&gt;biblioteca-panel y biblioteca-alertas leen el mismo topic y cada uno lleva su propio offset: si uno se detiene, el otro no se entera. Dentro de cada grupo, las tres particiones se reparten entre las instancias.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="488" width="880" height="40" as="geometry"/></mxCell>
