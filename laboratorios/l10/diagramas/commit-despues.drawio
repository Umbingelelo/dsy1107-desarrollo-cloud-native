<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="commit-despues" name="commit-despues">
    <mxGraphModel grid="1" gridSize="8" page="0" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="rotulo" value='&lt;span style="font-weight:600;font-size:12px;color:#2A6BC4;letter-spacing:0.14em"&gt;EL COMMIT DEL OFFSET, DESPUÉS DE ESCRIBIR&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="900" height="20" as="geometry"/></mxCell>
        <mxCell id="z1" value='&lt;span style="font-weight:600;font-size:12px;color:#2A6BC4;letter-spacing:0.14em"&gt;EN CADA MENSAJE&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#F1F6FD;strokeColor=#CBD9EC;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=16;spacingTop=8;container=1;pointerEvents=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="968" height="168" as="geometry"/></mxCell>
        <mxCell id="s1" value='&lt;span style="font-weight:600;font-size:15px;color:#1A1A1A"&gt;1 · leer&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#666666"&gt;el evento del offset N de su partición&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="z1"><mxGeometry x="24" y="48" width="200" height="96" as="geometry"/></mxCell>
        <mxCell id="s2" value='&lt;span style="font-weight:600;font-size:15px;color:#1A1A1A"&gt;2 · validar&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#666666"&gt;JSON y DTO; si falla, se registra y pasa al 4&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="z1"><mxGeometry x="264" y="48" width="200" height="96" as="geometry"/></mxCell>
        <mxCell id="s3" value='&lt;span style="font-weight:600;font-size:15px;color:#1A1A1A"&gt;3 · escribir&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace, Menlo, Consolas, monospace;font-size:13px;color:#1A1A1A;"&gt;INSERT&lt;/span&gt;&lt;span style="font-size:13px;color:#666666"&gt; con &lt;/span&gt;&lt;span style="font-family:ui-monospace, Menlo, Consolas, monospace;font-size:13px;color:#666666"&gt;evento_id&lt;/span&gt;&lt;span style="font-size:13px;color:#666666"&gt; como clave: un duplicado no suma&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="z1"><mxGeometry x="504" y="48" width="200" height="96" as="geometry"/></mxCell>
        <mxCell id="s4" value='&lt;span style="font-weight:600;font-size:15px;color:#1A1A1A"&gt;4 · commit del offset&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#666666"&gt;confirma N + 1, recién ahora&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;strokeColor=#307FE2;strokeWidth=2;" vertex="1" parent="z1"><mxGeometry x="744" y="48" width="200" height="96" as="geometry"/></mxCell>
        <mxCell id="a0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;fontFamily=Montserrat;fontSize=13;fontColor=#666666;labelBackgroundColor=#FFFFFF;strokeColor=#307FE2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;fontFamily=Montserrat;fontSize=13;fontColor=#666666;labelBackgroundColor=#FFFFFF;strokeColor=#307FE2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;fontFamily=Montserrat;fontSize=13;fontColor=#666666;labelBackgroundColor=#FFFFFF;strokeColor=#307FE2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="z2" value='&lt;span style="font-weight:600;font-size:12px;color:#2A6BC4;letter-spacing:0.14em"&gt;SI MUERE ENTRE EL INSERT Y EL COMMIT&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#F1F6FD;strokeColor=#CBD9EC;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=16;spacingTop=8;container=1;pointerEvents=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="0" y="232" width="968" height="168" as="geometry"/></mxCell>
        <mxCell id="f1" value='&lt;span style="color:#C0392B;font-weight:600"&gt;✗ el proceso muere&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#666666"&gt;el &lt;/span&gt;&lt;span style="font-family:ui-monospace, Menlo, Consolas, monospace;font-size:13px;color:#666666"&gt;INSERT&lt;/span&gt;&lt;span style="font-size:13px;color:#666666"&gt; quedó hecho y el offset N, sin confirmar&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fillColor=#FCECEA;strokeColor=#C0392B;strokeWidth=1.5;" vertex="1" parent="z2"><mxGeometry x="24" y="48" width="280" height="96" as="geometry"/></mxCell>
        <mxCell id="f2" value='&lt;span style="font-weight:600;font-size:15px;color:#1A1A1A"&gt;al volver, lee N otra vez&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#666666"&gt;el grupo sigue desde su último commit: llega el mismo evento&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="z2"><mxGeometry x="344" y="48" width="280" height="96" as="geometry"/></mxCell>
        <mxCell id="f3" value='&lt;span style="color:#1E7A4B;font-weight:600"&gt;✓ ya procesado, no suma&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#666666"&gt;el &lt;/span&gt;&lt;span style="font-family:ui-monospace, Menlo, Consolas, monospace;font-size:13px;color:#666666"&gt;INSERT&lt;/span&gt;&lt;span style="font-size:13px;color:#666666"&gt; choca con la clave; commit de N + 1 y sigue&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F5EE;strokeColor=#1E7A4B;strokeWidth=1.5;" vertex="1" parent="z2"><mxGeometry x="664" y="48" width="280" height="96" as="geometry"/></mxCell>
        <mxCell id="b1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;fontFamily=Montserrat;fontSize=13;fontColor=#666666;labelBackgroundColor=#FFFFFF;strokeColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="b2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;fontFamily=Montserrat;fontSize=13;fontColor=#666666;labelBackgroundColor=#FFFFFF;strokeColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pie" value='&lt;span style="font-size:14px;color:#666666"&gt;Commit manual después de escribir, más idempotencia: la entrega es al menos una vez y el resultado, exactamente una vez. Es el mismo principio del ack después del trabajo de la EP2.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="424" width="900" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
