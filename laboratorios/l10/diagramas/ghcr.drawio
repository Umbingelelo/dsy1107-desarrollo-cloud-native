  <diagram id="ghcr" name="ghcr">
    <mxGraphModel grid="1" gridSize="8" page="0" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="rotulo" value='&lt;span style="font-weight:600;font-size:12px;color:#2A6BC4;letter-spacing:0.14em"&gt;DE UN PUSH A MAIN A UNA IMAGEN QUE CUALQUIER MÁQUINA DESCARGA&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="900" height="20" as="geometry"/></mxCell>
        <mxCell id="n1" value='&lt;span style="font-weight:600;font-size:15px;color:#1A1A1A"&gt;1 · push a main&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace, Menlo, Consolas, monospace;font-size:13px;color:#1A1A1A;"&gt;git push origin main&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#666666"&gt;dispara el workflow&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="192" height="128" as="geometry"/></mxCell>
        <mxCell id="n2" value='&lt;span style="font-weight:600;font-size:15px;color:#1A1A1A"&gt;2 · workflow&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace, Menlo, Consolas, monospace;font-size:13px;color:#1A1A1A;"&gt;imagen.yml&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#666666"&gt;construye en los runners de GitHub, con &lt;/span&gt;&lt;span style="font-family:ui-monospace, Menlo, Consolas, monospace;font-size:13px;color:#666666"&gt;GITHUB_TOKEN&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="224" y="40" width="192" height="128" as="geometry"/></mxCell>
        <mxCell id="n3" value='&lt;span style="font-weight:600;font-size:15px;color:#1A1A1A"&gt;3 · GHCR&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace, Menlo, Consolas, monospace;font-size:13px;color:#1A1A1A;"&gt;ghcr.io/umbingelelo/&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace, Menlo, Consolas, monospace;font-size:13px;color:#1A1A1A;"&gt;biblioteca-eventos&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace, Menlo, Consolas, monospace;font-size:13px;color:#1A1A1A;"&gt;:&amp;lt;sha&amp;gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="448" y="40" width="192" height="128" as="geometry"/></mxCell>
        <mxCell id="n4" value='&lt;span style="font-weight:600;font-size:15px;color:#1A1A1A"&gt;4 · pública&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#666666"&gt;Package settings, Change visibility, Public&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;strokeColor=#307FE2;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="672" y="40" width="192" height="128" as="geometry"/></mxCell>
        <mxCell id="n5" value='&lt;span style="font-weight:600;font-size:15px;color:#1A1A1A"&gt;5 · la descarga&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace, Menlo, Consolas, monospace;font-size:13px;color:#1A1A1A;"&gt;docker pull …:&amp;lt;sha&amp;gt;&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#666666"&gt;cualquier máquina, sin credenciales&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;rounded=1;absoluteArcSize=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="896" y="40" width="192" height="128" as="geometry"/></mxCell>
        <mxCell id="a0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;fontFamily=Montserrat;fontSize=13;fontColor=#666666;labelBackgroundColor=#FFFFFF;strokeColor=#307FE2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;fontFamily=Montserrat;fontSize=13;fontColor=#666666;labelBackgroundColor=#FFFFFF;strokeColor=#307FE2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;fontFamily=Montserrat;fontSize=13;fontColor=#666666;labelBackgroundColor=#FFFFFF;strokeColor=#307FE2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;fontFamily=Montserrat;fontSize=13;fontColor=#666666;labelBackgroundColor=#FFFFFF;strokeColor=#307FE2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="nota3" value='&lt;span style="font-size:13px;color:#666666"&gt;En minúsculas: GHCR rechaza Umbingelelo y acepta umbingelelo.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="456" y="180" width="176" height="56" as="geometry"/></mxCell>
        <mxCell id="nota4" value='&lt;span style="font-size:13px;color:#666666"&gt;Una vez por imagen: GitHub crea cada imagen nueva como privada.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="680" y="180" width="176" height="56" as="geometry"/></mxCell>
        <mxCell id="ley0s" value="" style="shape=line;html=1;strokeWidth=2;strokeColor=#307FE2;" vertex="1" parent="1"><mxGeometry x="0" y="266" width="32" height="8" as="geometry"/></mxCell>
        <mxCell id="ley0t" value='&lt;span style="font-size:13px;color:#666666"&gt;cada push a main deja una imagen nueva con su sha&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="408" height="20" as="geometry"/></mxCell>
        <mxCell id="pie" value='&lt;span style="font-size:14px;color:#666666"&gt;La imagen se nombra con el sha del commit, nunca latest: así se sabe qué código corre. Es pública porque no lleva secretos, aunque el repositorio sea privado.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Montserrat;fontSize=13;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="296" width="900" height="40" as="geometry"/></mxCell>
