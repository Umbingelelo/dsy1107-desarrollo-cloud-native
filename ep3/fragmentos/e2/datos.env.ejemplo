# Ejemplo de /opt/vidalstore/secretos/datos.env en la maquina datos. La clave real no se versiona:
# se guarda como SecureString en Parameter Store y la maquina la escribe al desplegar. Se levanta en
# /opt/vidalstore/deploy/aws/datos/ con:
#   sudo docker compose --env-file /opt/vidalstore/secretos/datos.env up -d --wait
POSTGRES_PASSWORD=<clave-que-no-va-al-repositorio>
