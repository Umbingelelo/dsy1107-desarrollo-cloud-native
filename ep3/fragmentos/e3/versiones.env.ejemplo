# deploy/versiones.env: que imagen corre en cada maquina. Cambiar un sha y hacer merge a main
# es desplegar. Cada compose.yml de deploy/aws/<maquina>/ y deploy/azure/<maquina>/ usa estas
# variables en su linea image:. Siempre el sha, nunca latest.
GATEWAY=ghcr.io/<usuario-u-org>/<repo-gateway>:<sha>
BFF=ghcr.io/<usuario-u-org>/<repo-bff>:<sha>
FRONTEND=ghcr.io/<usuario-u-org>/<repo-frontend>:<sha>
CATALOGO=ghcr.io/<usuario-u-org>/<repo-catalogo>:<sha>
LICENCIAS=ghcr.io/<usuario-u-org>/<repo-licencias>:<sha>
EVENTOS=ghcr.io/<usuario-u-org>/vidalstore-eventos:<sha>
ADMIN=ghcr.io/<usuario-u-org>/vidalstore-admin:<sha>
