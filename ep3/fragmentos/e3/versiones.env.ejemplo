# deploy/versiones.env: que imagen corre en cada maquina. Cambiar un sha y hacer merge a main
# es desplegar. Cada compose.yml de deploy/aws/<maquina>/ y deploy/azure/<maquina>/ usa estas
# variables en su linea image:. Siempre el sha completo (40 caracteres), nunca latest; el usuario
# u organizacion, en minusculas. Cada imagen es publica: las maquinas la bajan sin credenciales.
GATEWAY=ghcr.io/<usuario-en-minusculas>/<repo-gateway>:<sha-de-40>
BFF=ghcr.io/<usuario-en-minusculas>/<repo-bff>:<sha-de-40>
FRONTEND=ghcr.io/<usuario-en-minusculas>/<repo-frontend>:<sha-de-40>
CATALOGO=ghcr.io/<usuario-en-minusculas>/<repo-catalogo>:<sha-de-40>
LICENCIAS=ghcr.io/<usuario-en-minusculas>/<repo-licencias>:<sha-de-40>
EVENTOS=ghcr.io/<usuario-en-minusculas>/vidalstore-eventos:<sha-de-40>
ADMIN=ghcr.io/<usuario-en-minusculas>/vidalstore-admin:<sha-de-40>
